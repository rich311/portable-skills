{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh",
            "timeout": 600,
            "statusMessage": "Setting up the cloud session..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["mcp__trello__*"],
    "deny": ["mcp__trello__archive_card", "mcp__trello__archive_list", "mcp__trello__delete_comment", "mcp__trello__delete_label"]
  }
}
