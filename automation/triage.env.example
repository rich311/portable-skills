# Copy to ~/.config/triage-cards/<name>.env and fill in. Keep it out of the repo (it holds a password).
PROJECT_DIR=/path/to/project
TRELLO_READY_LIST=<Ready To Start list id>
TRELLO_MEMBER_ID=<your Trello member id>
REPORT_TO=you@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=<app password>
SMTP_FROM=Triage <noreply@example.com>

# Optional
# Staged releases: buttons in the email for the staging site and the job that ships it live.
# PREVIEW_URL=https://staging.example.com
# SHIP_URL=https://github.com/<owner>/<repo>/actions/workflows/<ship workflow>.yml
START_HOUR=6
END_HOUR=22
